# SheRISE environment configuration
# Copy to .env.local for local development.

# --- Deployment surface split ---
# Set to "participant" on the sherise.com deployment, "admin" on the
# sherise-admin.com deployment. Leave unset locally to reach both surfaces
# for development/demo purposes. See src/lib/domain.ts and src/middleware.ts.
NEXT_PUBLIC_APP_SURFACE=

# --- Feature flags ---
# Facebook/LinkedIn app review has not started (spec Section 14). Keep false
# until both reviews clear; the queue/undo/status UI works either way against
# the mock providers in src/lib/crosspost.ts.
FEATURE_CROSSPOST_LIVE=false

# --- Database (Postgres / Supabase) ---
# src/lib/db.ts now runs on PostgreSQL via the `postgres` npm package
# (postgres.js) instead of better-sqlite3 -- see BUILD_STATUS.md "Postgres
# migration" section for full context on why (native-binary build failures
# on Windows/serverless) and current status (IN PROGRESS, not complete).
# Point this at a local Postgres for development or a hosted Supabase/
# Postgres connection string for staging/prod. Local sandbox default (used
# automatically if unset) is:
#   postgresql://postgres:sherise_dev_pw@localhost:5432/sherise
DATABASE_URL=

# --- Future: real SMS provider (Termii / Africa's Talking) ---
# Not yet selected per spec Section 14. Swap MockSmsProvider in
# src/lib/sms.ts once one is chosen.
# SMS_PROVIDER_API_KEY=

# --- Future: real Facebook Graph / LinkedIn Share API ---
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
